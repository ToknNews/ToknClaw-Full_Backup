def rebuild_portfolio_summary(state: Dict[str, Any]) -> None:
    portfolio = state.get("portfolio", {})
    open_positions = state.get("open_positions", {})
    closed_positions = state.get("closed_positions", [])

    if not isinstance(portfolio, dict):
        return

    gross_exposure = 0.0
    unrealized_pnl = 0.0

    if isinstance(open_positions, dict):
        for position in open_positions.values():
            if not isinstance(position, dict):
                continue
            gross_exposure += safe_float(position.get("market_value_usd"), 0.0)
            unrealized_pnl += safe_float(position.get("unrealized_pnl_usd"), 0.0)

    cash_usd = safe_float(portfolio.get("cash_usd", 0.0), 0.0)
    equity_usd = cash_usd + gross_exposure

    portfolio["gross_exposure_usd"] = round(gross_exposure, 4)
    portfolio["unrealized_pnl_usd"] = round(unrealized_pnl, 4)
    portfolio["equity_usd"] = round(equity_usd, 4)
    portfolio["open_position_count"] = len(open_positions) if isinstance(open_positions, dict) else 0
    portfolio["closed_position_count"] = len(closed_positions) if isinstance(closed_positions, list) else 0

