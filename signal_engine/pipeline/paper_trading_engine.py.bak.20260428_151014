def extract_trade_rows(snapshot: Dict[str, Any], cfg: Dict[str, Any]) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []

    if bool(cfg.get("trade_signal_rows_primary", True)):
        trade_signals = snapshot.get("trade_signals", {})
        if isinstance(trade_signals, dict):
            rows = trade_signals.get("rows", [])
            if isinstance(rows, list):
                for row in rows:
                    if not isinstance(row, dict):
                        continue

                    entity = clean_upper(row.get("entity"))
                    direction = normalize_direction(row.get("direction"))
                    confidence = safe_float(row.get("confidence"), 0.0)

                    out.append(
                        {
                            "entity": entity,
                            "direction": direction,
                            "confidence": confidence,
                            "priority_score": safe_float(row.get("priority_score"), 0.0),
                            "setup_family": clean_text(row.get("setup_family")),
                            "entry_style": clean_text(row.get("entry_style")),
                            "no_trade": safe_bool(row.get("no_trade"), False),
                            "reasons": [clean_text(x) for x in row.get("reasons", []) if clean_text(x)],
                            "agent_notes": [clean_text(x) for x in row.get("agent_notes", []) if clean_text(x)],
                            "title": f"{entity} trade signal",
                            "summary": ", ".join([clean_text(x) for x in row.get("reasons", []) if clean_text(x)]),
                            "signal_copy": deepcopy(row),
                            "source_type": "trade_signal_row",
                        }
                    )

    if out:
        out.sort(key=lambda row: trade_row_rank(row), reverse=True)
        return out

    if not bool(cfg.get("fallback_to_snapshot_signals", False)):
        return out

    raw_rows = snapshot.get("signals", [])
    if not isinstance(raw_rows, list):
        return out

    for row in raw_rows:
        if not isinstance(row, dict):
            continue

        signal_type = clean_text(row.get("signal_type"))
        entity = clean_upper(row.get("entity"))

        if signal_type in {
            "solana_trade_decision",
            "solana_trade_candidate",
        }:
            out.append(
                {
                    "entity": entity,
                    "direction": "bullish",
                    "confidence": safe_float(row.get("confidence"), 0.0),
                    "priority_score": safe_float(row.get("confidence"), 0.0),
                    "setup_family": "fallback_signal",
                    "entry_style": "balanced",
                    "no_trade": False,
                    "reasons": [],
                    "agent_notes": [],
                    "title": clean_text(row.get("title")),
                    "summary": clean_text(row.get("summary")),
                    "signal_copy": deepcopy(row),
                    "source_type": signal_type,
                }
            )

    out.sort(key=lambda row: trade_row_rank(row), reverse=True)
    return out

