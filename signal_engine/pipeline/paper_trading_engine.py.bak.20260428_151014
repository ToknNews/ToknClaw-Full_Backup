def entity_in_cooldown(state: Dict[str, Any], entity: str, cfg: Dict[str, Any]) -> bool:
    cooldowns = state.get("cooldowns", {})
    if not isinstance(cooldowns, dict):
        return False

    raw_until = cooldowns.get(entity)
    until_dt = parse_dt(raw_until)
    if until_dt is None:
        return False

    return utc_now() < until_dt


def set_cooldown(state: Dict[str, Any], entity: str, cfg: Dict[str, Any]) -> None:
    cooldown_minutes = safe_int(cfg.get("cooldown_minutes_after_close", 45), 45)
    until_dt = utc_now() + timedelta(minutes=cooldown_minutes)

    cooldowns = state.setdefault("cooldowns", {})
    if not isinstance(cooldowns, dict):
        state["cooldowns"] = {}
        cooldowns = state["cooldowns"]

    cooldowns[entity] = until_dt.isoformat()


def open_positions_count(state: Dict[str, Any]) -> int:
    open_positions = state.get("open_positions", {})
    if not isinstance(open_positions, dict):
        return 0
    return len(open_positions)


def count_positions_for_entity(state: Dict[str, Any], entity: str) -> int:
    open_positions = state.get("open_positions", {})
    if not isinstance(open_positions, dict):
        return 0

    count = 0
    for position in open_positions.values():
        if not isinstance(position, dict):
            continue
        if clean_upper(position.get("entity")) == entity:
            count += 1
    return count


def find_open_position_for_entity(state: Dict[str, Any], entity: str) -> Optional[Tuple[str, Dict[str, Any]]]:
    open_positions = state.get("open_positions", {})
    if not isinstance(open_positions, dict):
        return None

    entity = clean_upper(entity)

    for trade_id, position in open_positions.items():
        if not isinstance(position, dict):
            continue
        if clean_upper(position.get("entity")) == entity:
            return trade_id, position

    return None


def apply_entry_costs(price_usd: float, cfg: Dict[str, Any], side: str) -> float:
    slippage_bps = safe_float(cfg.get("slippage_bps_entry", 8), 8.0)
    fee_bps = safe_float(cfg.get("fee_bps_entry", 4), 4.0)
    total_bps = slippage_bps + fee_bps

    if side == "long":
        return price_usd * (1.0 + total_bps / 10000.0)

    if side == "short":
        return price_usd * (1.0 - total_bps / 10000.0)

    return price_usd


def apply_exit_costs(price_usd: float, cfg: Dict[str, Any], side: str) -> float:
    slippage_bps = safe_float(cfg.get("slippage_bps_exit", 8), 8.0)
    fee_bps = safe_float(cfg.get("fee_bps_exit", 4), 4.0)
    total_bps = slippage_bps + fee_bps

    if side == "long":
        return price_usd * (1.0 - total_bps / 10000.0)

    if side == "short":
        return price_usd * (1.0 + total_bps / 10000.0)

    return price_usd


def pnl_pct_for_position(side: str, entry_price: float, mark_price: float) -> float:
    if entry_price <= 0:
        return 0.0

    if side == "long":
        return ((mark_price / entry_price) - 1.0) * 100.0

    if side == "short":
        return ((entry_price / mark_price) - 1.0) * 100.0 if mark_price > 0 else 0.0

    return 0.0


def pnl_usd_for_position(side: str, entry_price: float, mark_price: float, quantity: float) -> float:
    if side == "long":
        return (mark_price - entry_price) * quantity

    if side == "short":
        return (entry_price - mark_price) * quantity

    return 0.0


def current_trade_row_for_entity(trade_rows: List[Dict[str, Any]], entity: str) -> Optional[Dict[str, Any]]:
    entity = clean_upper(entity)

    for row in trade_rows:
        if clean_upper(row.get("entity")) == entity:
            return row

    return None


def weakest_open_position(state: Dict[str, Any]) -> Optional[Tuple[str, Dict[str, Any], float, float]]:
    open_positions = state.get("open_positions", {})
    if not isinstance(open_positions, dict) or not open_positions:
        return None

    weakest = None

    for trade_id, position in open_positions.items():
        if not isinstance(position, dict):
            continue

        priority_score = safe_float(position.get("priority_score"), 0.0)
        confidence = safe_float(position.get("confidence"), 0.0)

        key = (priority_score, confidence)

        if weakest is None or key < weakest[2:]:
            weakest = (trade_id, position, priority_score, confidence)

    return weakest


def should_rotate_for_candidate(state: Dict[str, Any], cfg: Dict[str, Any], candidate_row: Dict[str, Any]) -> Optional[Tuple[str, Dict[str, Any]]]:
    if not bool(cfg.get("rotation_enabled", True)):
        return None

    candidate_priority = safe_float(candidate_row.get("priority_score"), 0.0)
    candidate_confidence = safe_float(candidate_row.get("confidence"), 0.0)

    same_entity = find_open_position_for_entity(state, candidate_row.get("entity"))
    if same_entity and bool(cfg.get("replace_weaker_same_symbol", True)):
        trade_id, position = same_entity
        current_direction = normalize_direction(position.get("direction"))
        candidate_direction = normalize_direction(candidate_row.get("direction"))
        current_priority = safe_float(position.get("priority_score"), 0.0)
        current_confidence = safe_float(position.get("confidence"), 0.0)

        if current_direction != candidate_direction:
            priority_edge = candidate_priority - current_priority
            confidence_edge = candidate_confidence - current_confidence

            if (
                priority_edge >= safe_float(cfg.get("min_rotation_priority_edge", 0.15), 0.15)
                or confidence_edge >= safe_float(cfg.get("min_rotation_confidence_edge", 0.08), 0.08)
            ):
                return trade_id, position

    if open_positions_count(state) < safe_int(cfg.get("max_open_positions", 4), 4):
        return None

    weakest = weakest_open_position(state)
    if weakest is None:
        return None

    trade_id, position, weakest_priority, weakest_confidence = weakest

    priority_edge = candidate_priority - weakest_priority
    confidence_edge = candidate_confidence - weakest_confidence

    if (
        priority_edge >= safe_float(cfg.get("min_rotation_priority_edge", 0.15), 0.15)
        or confidence_edge >= safe_float(cfg.get("min_rotation_confidence_edge", 0.08), 0.08)
    ):
        return trade_id, position

    return None


def close_position(
    state: Dict[str, Any],
    cfg: Dict[str, Any],
    trade_id: str,
    position: Dict[str, Any],
    exit_mark_price_usd: float,
    close_reason: str,
) -> None:
    open_positions = state.get("open_positions", {})
    if not isinstance(open_positions, dict):
        return

    portfolio = state.get("portfolio", {})
    quantity = safe_float(position.get("quantity"), 0.0)
    entry_price = safe_float(position.get("entry_price_usd"), 0.0)
    side = clean_text(position.get("side"))

    exit_price = apply_exit_costs(exit_mark_price_usd, cfg, side)
    exit_value_usd = quantity * exit_price
    realized_pnl_usd = pnl_usd_for_position(side, entry_price, exit_price, quantity)
    realized_pnl_pct = pnl_pct_for_position(side, entry_price, exit_price)

    closed_position = deepcopy(position)
    closed_position["status"] = "closed"
    closed_position["updated_at"] = now_iso()
    closed_position["closed_at"] = now_iso()
    closed_position["close_reason"] = clean_text(close_reason)
    closed_position["exit_price_usd"] = round(exit_price, 12)
    closed_position["mark_price_usd"] = round(exit_mark_price_usd, 12)
    closed_position["market_value_usd"] = round(exit_value_usd, 4)
    closed_position["unrealized_pnl_usd"] = 0.0
    closed_position["unrealized_pnl_pct"] = 0.0
    closed_position["realized_pnl_usd"] = round(realized_pnl_usd, 4)
    closed_position["realized_pnl_pct"] = round(realized_pnl_pct, 4)

    closed_positions = state.setdefault("closed_positions", [])
    closed_positions.append(closed_position)

    max_closed = safe_int(cfg.get("max_closed_positions", 5000), 5000)
    if len(closed_positions) > max_closed:
        state["closed_positions"] = closed_positions[-max_closed:]

    portfolio["cash_usd"] = round(safe_float(portfolio.get("cash_usd", 0.0), 0.0) + exit_value_usd, 4)
    portfolio["realized_pnl_usd"] = round(
        safe_float(portfolio.get("realized_pnl_usd", 0.0), 0.0) + realized_pnl_usd,
        4,
    )

    state["summary"]["positions_closed"] = safe_int(state["summary"].get("positions_closed", 0), 0) + 1

    if realized_pnl_usd > 0:
        portfolio["win_count"] = safe_int(portfolio.get("win_count", 0), 0) + 1
    elif realized_pnl_usd < 0:
        portfolio["loss_count"] = safe_int(portfolio.get("loss_count", 0), 0) + 1
    else:
        portfolio["flat_count"] = safe_int(portfolio.get("flat_count", 0), 0) + 1

    summary_key = f"closed_{clean_text(close_reason)}"
    state["summary"][summary_key] = safe_int(state["summary"].get(summary_key, 0), 0) + 1

    set_cooldown(state, clean_upper(position.get("entity")), cfg)

    append_activity(
        state,
        cfg,
        "position_closed",
        f"Closed paper {side} for {clean_upper(position.get('entity'))}",
        {
            "trade_id": trade_id,
            "entity": clean_upper(position.get("entity")),
            "close_reason": clean_text(close_reason),
            "realized_pnl_usd": round(realized_pnl_usd, 4),
            "realized_pnl_pct": round(realized_pnl_pct, 4),
        },
    )

    if trade_id in open_positions:
        del open_positions[trade_id]

