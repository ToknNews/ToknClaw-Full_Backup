FLOW_EXIT_RULES = {
    "long": [
        ("oi_build_decel", "flow_deceleration"),
        ("oi_build_fading", "flow_deceleration"),
        ("oi_unwind_accel", "flow_unwind"),
        ("oi_unwind_base", "flow_unwind"),
        ("long_flush", "flow_liquidation_risk"),
        ("bearish_confirm", "flow_bearish_confirm"),
    ],
    "short": [
        ("oi_build_accel", "flow_reversal"),
        ("oi_accel_base", "flow_reversal"),
        ("short_flush", "flow_liquidation_risk"),
        ("bullish_confirm", "flow_bullish_confirm"),
    ]
}


def should_close_on_flow(position: Dict[str, Any], current_row: Optional[Dict[str, Any]]) -> Optional[str]:
    if not isinstance(current_row, dict):
        return None

    side = clean_text(position.get("side"))
    reasons = current_row.get("reasons", [])

    if not isinstance(reasons, list):
        return None

    rules = FLOW_EXIT_RULES.get(side, [])

    for key, label in rules:
        for reason in reasons:
            if key in clean_text(reason):
                return label

    return None

