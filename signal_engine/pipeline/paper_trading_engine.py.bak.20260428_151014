def maybe_open_position(
    state: Dict[str, Any],
    cfg: Dict[str, Any],
    price_history: Dict[str, Any],
    row: Dict[str, Any],
) -> None:
    entity = clean_upper(row.get("entity"))
    direction = normalize_direction(row.get("direction"))
    side = direction_side(direction)
    confidence = safe_float(row.get("confidence"), 0.0)

    # ---------------------------------------------------
    # 🔴 PRIORITY FILTER (PREVENT WEAK TRADES)
    # ---------------------------------------------------

    priority_score = safe_float(row.get("priority_score"), 0.0)

    if priority_score < 0.25:
        append_decision_log(state, cfg, row, "skipped_low_priority")
        return

    state["summary"]["decisions_seen"] = safe_int(state["summary"].get("decisions_seen", 0), 0) + 1

    if safe_bool(row.get("no_trade"), False) or direction in {"no_trade", "neutral"}:
        append_decision_log(state, cfg, row, "skipped_no_trade")
        return

    if entity not in set(cfg.get("allowed_entities", [])):
        state["summary"]["skipped_not_allowed_entity"] = safe_int(
            state["summary"].get("skipped_not_allowed_entity", 0), 0
        ) + 1
        append_decision_log(state, cfg, row, "skipped_not_allowed_entity")
        return

    if not allowed_direction(cfg, direction):
        state["summary"]["skipped_direction_not_allowed"] = safe_int(
            state["summary"].get("skipped_direction_not_allowed", 0), 0
        ) + 1
        append_decision_log(state, cfg, row, "skipped_direction_not_allowed")
        return

    min_confidence = confidence_threshold_for_direction(cfg, direction)
    if confidence < min_confidence:
        state["summary"]["skipped_low_confidence"] = safe_int(
            state["summary"].get("skipped_low_confidence", 0), 0
        ) + 1
        append_decision_log(state, cfg, row, "skipped_low_confidence")
        return

    if entity_in_cooldown(state, entity, cfg):
        state["summary"]["skipped_cooldown"] = safe_int(state["summary"].get("skipped_cooldown", 0), 0) + 1
        append_decision_log(state, cfg, row, "skipped_cooldown")
        return

    # duplicate protection
    existing_same_entity = find_open_position_for_entity(state, entity)
    if existing_same_entity is not None:
        trade_id, position = existing_same_entity
        current_direction = normalize_direction(position.get("direction"))
        current_priority = safe_float(position.get("priority_score"), 0.0)
        current_confidence = safe_float(position.get("confidence"), 0.0)

        if current_direction == direction:
            state["summary"]["skipped_duplicate"] = safe_int(state["summary"].get("skipped_duplicate", 0), 0) + 1
            append_decision_log(state, cfg, row, "skipped_duplicate_same_direction")
            return

        priority_edge = safe_float(row.get("priority_score"), 0.0) - current_priority
        confidence_edge = confidence - current_confidence

        if not bool(cfg.get("replace_weaker_same_symbol", True)):
            state["summary"]["skipped_duplicate"] = safe_int(state["summary"].get("skipped_duplicate", 0), 0) + 1
            append_decision_log(state, cfg, row, "skipped_duplicate_opp_direction")
            return

        if (
            priority_edge >= safe_float(cfg.get("min_rotation_priority_edge", 0.15), 0.15)
            or confidence_edge >= safe_float(cfg.get("min_rotation_confidence_edge", 0.08), 0.08)
        ):
            latest_price = latest_price_for_entity(price_history, entity)
            if price_point_ok(latest_price):
                close_position(
                    state=state,
                    cfg=cfg,
                    trade_id=trade_id,
                    position=position,
                    exit_mark_price_usd=safe_float(latest_price.get("price_usd"), 0.0),
                    close_reason="rotation_replace",
                )
                state["summary"]["positions_rotated_out"] = safe_int(
                    state["summary"].get("positions_rotated_out", 0),
                    0,
                ) + 1
            else:
                append_decision_log(state, cfg, row, "skipped_rotation_no_price")
                return
        else:
            state["summary"]["skipped_duplicate"] = safe_int(state["summary"].get("skipped_duplicate", 0), 0) + 1
            append_decision_log(state, cfg, row, "skipped_weaker_than_existing")
            return

    max_open_positions = safe_int(cfg.get("max_open_positions", 4), 4)
    if open_positions_count(state) >= max_open_positions:
        rotate_target = should_rotate_for_candidate(state, cfg, row)

        if rotate_target is None:
            state["summary"]["skipped_capacity"] = safe_int(state["summary"].get("skipped_capacity", 0), 0) + 1
            append_decision_log(state, cfg, row, "skipped_capacity")
            return

        rotate_trade_id, rotate_position = rotate_target
        rotate_entity = clean_upper(rotate_position.get("entity"))
        latest_price = latest_price_for_entity(price_history, rotate_entity)

        if not price_point_ok(latest_price):
            state["summary"]["skipped_no_price"] = safe_int(state["summary"].get("skipped_no_price", 0), 0) + 1
            append_decision_log(state, cfg, row, "skipped_rotation_target_no_price")
            return

        close_position(
            state=state,
            cfg=cfg,
            trade_id=rotate_trade_id,
            position=rotate_position,
            exit_mark_price_usd=safe_float(latest_price.get("price_usd"), 0.0),
            close_reason="rotation_replace",
        )
        state["summary"]["positions_rotated_out"] = safe_int(
            state["summary"].get("positions_rotated_out", 0),
            0,
        ) + 1

    latest_price = latest_price_for_entity(price_history, entity)
    if not price_point_ok(latest_price):
        state["summary"]["skipped_no_price"] = safe_int(state["summary"].get("skipped_no_price", 0), 0) + 1
        append_decision_log(state, cfg, row, "skipped_no_price")
        return

    mark_price = safe_float(latest_price.get("price_usd"), 0.0)
    entry_price = apply_entry_costs(mark_price, cfg, side)
    position_size_usd = effective_position_size_usd(cfg, row)

    portfolio = state.get("portfolio", {})
    cash_usd = safe_float(portfolio.get("cash_usd", 0.0), 0.0)

    if cash_usd < position_size_usd:
        state["summary"]["skipped_capacity"] = safe_int(state["summary"].get("skipped_capacity", 0), 0) + 1
        append_decision_log(state, cfg, row, "skipped_insufficient_cash")
        return

    quantity = position_size_usd / entry_price if entry_price > 0 else 0.0
    if quantity <= 0:
        state["summary"]["skipped_no_price"] = safe_int(state["summary"].get("skipped_no_price", 0), 0) + 1
        append_decision_log(state, cfg, row, "skipped_invalid_quantity")
        return

    opened_at = now_iso()
    trade_id = make_trade_id(entity, opened_at, direction)

    position = {
        "trade_id": trade_id,
        "status": "open",
        "entity": entity,
        "opened_at": opened_at,
        "updated_at": opened_at,
        "direction": direction,
        "side": side,
        "confidence": confidence,
        "priority_score": safe_float(row.get("priority_score"), 0.0),
        "setup_family": clean_text(row.get("setup_family")),
        "entry_style": clean_text(row.get("entry_style")),
        "entry_reasons": deepcopy(row.get("reasons", [])),
        "entry_agent_notes": deepcopy(row.get("agent_notes", [])),
        "entry_price_usd": round(entry_price, 12),
        "mark_price_usd": round(mark_price, 12),
        "position_size_usd": round(position_size_usd, 4),
        "quantity": round(quantity, 12),
        "market_value_usd": round(quantity * mark_price, 4),
        "unrealized_pnl_usd": 0.0,
        "unrealized_pnl_pct": 0.0,
        "realized_pnl_usd": 0.0,
        "close_reason": None,
        "closed_at": None,
        "exit_price_usd": None,
        "source_title": clean_text(row.get("title")),
        "source_summary": clean_text(row.get("summary")),
        "source_type": clean_text(row.get("source_type")),
        "signal_copy": deepcopy(row.get("signal_copy")) if bool(cfg.get("store_signal_copy", True)) else None,
    }

    open_positions = state.setdefault("open_positions", {})
    open_positions[trade_id] = position

    portfolio["cash_usd"] = round(cash_usd - position_size_usd, 4)

    state["summary"]["positions_opened"] = safe_int(state["summary"].get("positions_opened", 0), 0) + 1

    append_decision_log(state, cfg, row, "opened")
    append_activity(
        state,
        cfg,
        "position_opened",
        f"Opened paper {side} for {entity}",
        {
            "trade_id": trade_id,
            "entity": entity,
            "direction": direction,
            "entry_price_usd": position["entry_price_usd"],
            "position_size_usd": position["position_size_usd"],
            "confidence": confidence,
            "priority_score": position["priority_score"],
            "setup_family": position["setup_family"],
        },
    )

