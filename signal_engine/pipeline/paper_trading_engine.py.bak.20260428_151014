def update_open_positions(
    state: Dict[str, Any],
    cfg: Dict[str, Any],
    price_history: Dict[str, Any],
    trade_rows: List[Dict[str, Any]],
) -> None:
    open_positions = state.get("open_positions", {})
    if not isinstance(open_positions, dict):
        return

    to_close: List[tuple[str, Dict[str, Any], float, str]] = []

    for trade_id, position in list(open_positions.items()):
        if not isinstance(position, dict):
            continue

        entity = clean_upper(position.get("entity"))
        side = clean_text(position.get("side"))
        latest_price = latest_price_for_entity(price_history, entity)

        if not price_point_ok(latest_price):
            continue

        mark_price = safe_float(latest_price.get("price_usd"), 0.0)
        quantity = safe_float(position.get("quantity"), 0.0)
        entry_price = safe_float(position.get("entry_price_usd"), 0.0)

        unrealized_pnl_usd = pnl_usd_for_position(side, entry_price, mark_price, quantity)
        unrealized_pnl_pct = pnl_pct_for_position(side, entry_price, mark_price)

        position["updated_at"] = now_iso()
        position["mark_price_usd"] = round(mark_price, 12)
        position["market_value_usd"] = round(mark_price * quantity, 4)
        position["unrealized_pnl_usd"] = round(unrealized_pnl_usd, 4)
        position["unrealized_pnl_pct"] = round(unrealized_pnl_pct, 4)

        opened_at = parse_dt(position.get("opened_at"))
        age_minutes = 0.0
        if opened_at is not None:
            age_minutes = (utc_now() - opened_at).total_seconds() / 60.0

        if side == "long":
            take_profit_pct = safe_float(cfg.get("take_profit_pct_long", 6.0), 6.0)
            stop_loss_pct = safe_float(cfg.get("stop_loss_pct_long", -3.0), -3.0)
            hold_confidence_floor = safe_float(cfg.get("min_live_confidence_to_hold_long", 0.25), 0.25)
        else:
            take_profit_pct = safe_float(cfg.get("take_profit_pct_short", 6.0), 6.0)
            stop_loss_pct = safe_float(cfg.get("stop_loss_pct_short", -3.0), -3.0)
            hold_confidence_floor = safe_float(cfg.get("min_live_confidence_to_hold_short", 0.25), 0.25)

        current_row = current_trade_row_for_entity(trade_rows, entity)
        current_direction = "neutral"
        current_confidence = 0.0
        current_no_trade = False

        flow_exit_reason = should_close_on_flow(position, current_row)
        if flow_exit_reason:
            to_close.append((trade_id, position, mark_price, flow_exit_reason))
            continue

        if isinstance(current_row, dict):
            current_direction = normalize_direction(current_row.get("direction"))
            current_confidence = safe_float(current_row.get("confidence"), 0.0)
            current_no_trade = safe_bool(current_row.get("no_trade"), False)

        if bool(cfg.get("close_on_direction_flip", True)):
            if side == "long" and current_direction in {"bearish", "strong_bearish"}:
                to_close.append((trade_id, position, mark_price, "direction_flip"))
                continue

            if side == "short" and current_direction in {"bullish", "strong_bullish"}:
                to_close.append((trade_id, position, mark_price, "direction_flip"))
                continue

        if bool(cfg.get("close_on_no_trade_signal", True)) and current_no_trade:
            to_close.append((trade_id, position, mark_price, "no_trade_signal"))
            continue

        if bool(cfg.get("close_on_neutral_signal", True)) and current_direction == "neutral":
            to_close.append((trade_id, position, mark_price, "neutral_signal"))
            continue

        if bool(cfg.get("close_on_confidence_decay", True)) and current_confidence < hold_confidence_floor:
            to_close.append((trade_id, position, mark_price, "confidence_decay"))
            continue

        if unrealized_pnl_pct >= take_profit_pct:
            to_close.append((trade_id, position, mark_price, "take_profit"))
            continue

        if unrealized_pnl_pct <= stop_loss_pct:
            to_close.append((trade_id, position, mark_price, "stop_loss"))
            continue

        # emergency backstop only
        max_hold_minutes = safe_int(cfg.get("max_hold_minutes", 9999), 9999)
        if max_hold_minutes > 0 and age_minutes >= max_hold_minutes:
            to_close.append((trade_id, position, mark_price, "max_hold"))
            continue

    for trade_id, position, mark_price, close_reason in to_close:
        close_position(state, cfg, trade_id, position, mark_price, close_reason)

