def build_paper_trading(snapshot: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    cfg = load_engine_config()
    state = load_state(cfg)

    if not bool(cfg.get("enabled", True)):
        state["engine_status"] = {
            "status": "disabled",
            "last_run_at": now_iso(),
            "last_error": None,
        }
        return state

    try:
        snapshot = snapshot if isinstance(snapshot, dict) else load_snapshot()
        price_history = load_price_history()

        trade_rows = extract_trade_rows(snapshot, cfg)

        debug_log(
            cfg,
            f"trade_rows={len(trade_rows)} "
            f"allowed_entities={len(cfg.get('allowed_entities', []))} "
            f"allowed_directions={cfg.get('allowed_directions', [])}"
        )

        update_open_positions(
            state=state,
            cfg=cfg,
            price_history=price_history,
            trade_rows=trade_rows,
        )

        for row in trade_rows:
            maybe_open_position(
                state=state,
                cfg=cfg,
                price_history=price_history,
                row=row,
            )

        rebuild_portfolio_summary(state)

        state["updated_at"] = now_iso()
        state["engine_status"] = {
            "status": "ok",
            "last_run_at": now_iso(),
            "last_error": None,
        }

        write_json_atomic(STATE_PATH, STATE_TMP_PATH, state)

        debug_log(
            cfg,
            "open_positions="
            + str(state["portfolio"].get("open_position_count", 0))
            + " closed_positions="
            + str(state["portfolio"].get("closed_position_count", 0))
            + " equity_usd="
            + str(state["portfolio"].get("equity_usd", 0.0))
        )

        return state

    except Exception as e:
        state["updated_at"] = now_iso()
        state["engine_status"] = {
            "status": "error",
            "last_run_at": now_iso(),
            "last_error": str(e),
        }
        write_json_atomic(STATE_PATH, STATE_TMP_PATH, state)
        raise

# ---------------------------------------------------
