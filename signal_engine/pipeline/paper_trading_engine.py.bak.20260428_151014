def latest_price_for_entity(price_history: Dict[str, Any], entity: str) -> Optional[Dict[str, Any]]:
    tokens = price_history.get("tokens", {})
    if not isinstance(tokens, dict):
        return None

    rows = tokens.get(entity)
    if not isinstance(rows, list) or not rows:
        return None

    valid_rows = [r for r in rows if isinstance(r, dict)]
    if not valid_rows:
        return None

    valid_rows.sort(key=lambda x: clean_text(x.get("timestamp")))
    return valid_rows[-1]


def price_point_ok(row: Optional[Dict[str, Any]]) -> bool:
    if not isinstance(row, dict):
        return False

    price = safe_float(row.get("price_usd"), 0.0)
    return price > 0.0

