def append_activity(
    state: Dict[str, Any],
    cfg: Dict[str, Any],
    event_type: str,
    message: str,
    payload: Optional[Dict[str, Any]] = None,
) -> None:
    activity_log = state.setdefault("activity_log", [])
    if not isinstance(activity_log, list):
        state["activity_log"] = []
        activity_log = state["activity_log"]

    activity_log.append(
        {
            "timestamp": now_iso(),
            "event_type": clean_text(event_type),
            "message": clean_text(message),
            "payload": payload or {},
        }
    )

    max_activity = safe_int(cfg.get("max_activity_log", 500), 500)
    if len(activity_log) > max_activity:
        state["activity_log"] = activity_log[-max_activity:]


def append_decision_log(state: Dict[str, Any], cfg: Dict[str, Any], row: Dict[str, Any], outcome: str) -> None:
    decision_log = state.setdefault("decision_log", [])
    if not isinstance(decision_log, list):
        state["decision_log"] = []
        decision_log = state["decision_log"]

    decision_log.append(
        {
            "timestamp": now_iso(),
            "entity": clean_upper(row.get("entity")),
            "direction": normalize_direction(row.get("direction")),
            "confidence": safe_float(row.get("confidence"), 0.0),
            "priority_score": safe_float(row.get("priority_score"), 0.0),
            "setup_family": clean_text(row.get("setup_family")),
            "entry_style": clean_text(row.get("entry_style")),
            "title": clean_text(row.get("title")),
            "summary": clean_text(row.get("summary")),
            "outcome": clean_text(outcome),
        }
    )

    max_log = safe_int(cfg.get("max_decision_log", 1000), 1000)
    if len(decision_log) > max_log:
        state["decision_log"] = decision_log[-max_log:]

