def utc_now() -> datetime:
    return datetime.now(UTC)


def now_iso() -> str:
    return utc_now().isoformat()


def parse_dt(value: Any) -> Optional[datetime]:
    text = str(value or "").strip()
    if not text:
        return None

    try:
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"

        dt = datetime.fromisoformat(text)

        if dt.tzinfo is None:
            return dt.replace(tzinfo=UTC)

        return dt.astimezone(UTC)
    except Exception:
        return None


def clean_text(value: Any) -> str:
    return str(value or "").strip()


def clean_upper(value: Any) -> str:
    return clean_text(value).upper()


def safe_int(value: Any, default: int) -> int:
    try:
        return int(value)
    except Exception:
        return default


def safe_float(value: Any, default: float) -> float:
    try:
        return float(value)
    except Exception:
        return default


def safe_bool(value: Any, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if value in {"true", "True", "1", 1}:
        return True
    if value in {"false", "False", "0", 0}:
        return False
    return default


def debug_enabled(cfg: Dict[str, Any]) -> bool:
    return bool(cfg.get("debug", True))


def debug_log(cfg: Dict[str, Any], message: str) -> None:
    if debug_enabled(cfg):
        print(f"[PAPER TRADING] {message}")


def read_json_file(path: Path, default: Any) -> Any:
    if not path.exists():
        return default

    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def write_json_atomic(path: Path, tmp_path: Path, payload: Dict[str, Any]) -> None:
    tmp_path.parent.mkdir(parents=True, exist_ok=True)

    with open(tmp_path, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2)


    # safer atomic write
    if tmp_path.exists():
        tmp_path.replace(path)
    else:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2)

def load_engine_config() -> Dict[str, Any]:
    cfg = load_config(CONFIG_FILE)

    if not isinstance(cfg, dict):
        return deepcopy(DEFAULT_CONFIG)

    merged = deepcopy(DEFAULT_CONFIG)
    merged.update(cfg)

    for key in ["allowed_entities", "allowed_directions"]:
        value = merged.get(key)
        if not isinstance(value, list):
            merged[key] = deepcopy(DEFAULT_CONFIG[key])
        else:
            if key == "allowed_entities":
                merged[key] = [clean_upper(x) for x in value if clean_text(x)]
            else:
                merged[key] = [clean_text(x) for x in value if clean_text(x)]

    return merged


def make_trade_id(entity: str, opened_at: str, direction: str) -> str:
    raw = f"{entity}||{opened_at}||{direction}"
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:24]


def normalize_direction(value: Any) -> str:
    direction = clean_text(value)
    if direction in {"bullish", "strong_bullish", "bearish", "strong_bearish", "neutral", "no_trade"}:
        return direction
    return "neutral"


def direction_side(direction: str) -> str:
    if direction in {"bullish", "strong_bullish"}:
        return "long"
    if direction in {"bearish", "strong_bearish"}:
        return "short"
    return "flat"


def allowed_direction(cfg: Dict[str, Any], direction: str) -> bool:
    allowed = set(cfg.get("allowed_directions", []))
    if direction not in allowed:
        return False

    side = direction_side(direction)

    if side == "long" and not bool(cfg.get("allow_long", True)):
        return False

    if side == "short" and not bool(cfg.get("allow_short", False)):
        return False

    return side in {"long", "short"}


def confidence_threshold_for_direction(cfg: Dict[str, Any], direction: str) -> float:
    if direction == "bullish":
        return safe_float(cfg.get("min_confidence_bullish", 0.25), 0.25)
    if direction == "strong_bullish":
        return safe_float(cfg.get("min_confidence_strong_bullish", 0.45), 0.45)
    if direction == "bearish":
        return safe_float(cfg.get("min_confidence_bearish", 0.25), 0.25)
    if direction == "strong_bearish":
        return safe_float(cfg.get("min_confidence_strong_bearish", 0.45), 0.45)
    return 1.0


def effective_position_size_usd(cfg: Dict[str, Any], row: Dict[str, Any]) -> float:
    """
    Hybrid sizing:
    1. Try trade_sizing_engine (primary)
    2. Fallback to confidence-based sizing (secondary)
    """

    from pathlib import Path
    import json

    SIZING_PATH = Path("/opt/toknclaw/data/analytics/trade_sizing.json")

    entity = str(row.get("entity", "")).upper()

    # ---------------------------------------------------
    # 🔴 PRIMARY: trade_sizing_engine
    # ---------------------------------------------------
    if SIZING_PATH.exists():
        try:
            with open(SIZING_PATH) as f:
                data = json.load(f)

            for r in data.get("rows", []):
                if str(r.get("entity", "")).upper() == entity:
                    size = float(r.get("recommended_position_usd", 0))

                    if size > 0:
                        return round(size, 4)

        except Exception as e:
            print(f"[SIZING] fallback due to error: {e}")

    # ---------------------------------------------------
    # 🔴 FALLBACK: existing confidence sizing
    # ---------------------------------------------------

    base_size = safe_float(cfg.get("base_position_size_usd", 250.0), 250.0)

    if not bool(cfg.get("confidence_position_sizing", True)):
        return round(base_size, 4)

    confidence = safe_float(row.get("confidence"), 0.0)

    nonlinear_component = confidence ** 2
    curve_strength = 2.5
    multiplier = 1.0 + (nonlinear_component * curve_strength)

    multiplier_cap = safe_float(cfg.get("confidence_size_multiplier_cap", 2.2), 2.2)
    multiplier = min(multiplier, multiplier_cap)

    size = base_size * multiplier
    max_size = safe_float(cfg.get("max_position_size_usd", 700.0), 700.0)

    return round(min(size, max_size), 4)

def trade_row_rank(row: Dict[str, Any]) -> Tuple[float, float]:
    return (
        safe_float(row.get("priority_score"), 0.0),
        safe_float(row.get("confidence"), 0.0),
    )

