def _strategy_crowding_fade(rows: List[Dict[str, Any]], types: Counter) -> Dict[str, Any]:
    bullish = 0.0
    bearish = 0.0
    reasons: List[str] = []

    if int(types.get("perp_strategy_crowded_longs", 0)) > 0:
        bearish += 0.18
        reasons.append("crowding_fade_longs")

    if int(types.get("perp_strategy_crowded_shorts", 0)) > 0:
        bullish += 0.18
        reasons.append("crowding_fade_shorts")

    if int(types.get("perp_liquidation_risk_long_flush", 0)) > 0:
        bearish += 0.12
        reasons.append("crowding_liq_long")

    if int(types.get("perp_liquidation_risk_short_flush", 0)) > 0:
        bullish += 0.12
        reasons.append("crowding_liq_short")

    return {"name": "crowding_fade", "bullish": _scaled(bullish), "bearish": _scaled(bearish), "reasons": reasons}


def _strategy_trend_continuation(rows: List[Dict[str, Any]], types: Counter) -> Dict[str, Any]:
    bullish = 0.0
    bearish = 0.0
    reasons: List[str] = []

    if int(types.get("perp_trend_bullish", 0)) > 0:
        bullish += 0.28
        reasons.append("continuation_bull")

    if int(types.get("perp_trend_bearish", 0)) > 0:
        bearish += 0.28
        reasons.append("continuation_bear")

    if int(types.get("perp_trend_short_unwind", 0)) > 0:
        bullish += 0.10
        reasons.append("continuation_short_unwind")

    if int(types.get("perp_trend_long_unwind", 0)) > 0:
        bearish += 0.10
        reasons.append("continuation_long_unwind")

    return {"name": "trend_continuation", "bullish": _scaled(bullish), "bearish": _scaled(bearish), "reasons": reasons}


def _strategy_funding_baseline(rows: List[Dict[str, Any]], types: Counter) -> Dict[str, Any]:
    bullish = 0.0
    bearish = 0.0
    reasons: List[str] = []

    funding_rows = _rows_of_type(rows, "perp_funding_rate")
    if not funding_rows:
        return {"name": "funding_baseline", "bullish": 0.0, "bearish": 0.0, "reasons": []}

    values: List[float] = []
    for row in funding_rows:
        avg = _parse_summary_float(row.get("summary"), "avg", 0.0)
        if avg != 0.0:
            values.append(avg)

    if not values:
        return {"name": "funding_baseline", "bullish": 0.0, "bearish": 0.0, "reasons": []}

    avg_funding = sum(values) / len(values)
    abs_funding = abs(avg_funding)

    floor = 0.00003
    ceiling = 0.00030
    cap_score = 0.18

    if abs_funding >= floor:
        normalized = min(max((abs_funding - floor) / (ceiling - floor), 0.0), 1.0)
        score = round(normalized * cap_score, 6)

        if avg_funding < 0:
            bullish += score
            reasons.append("funding_negative")
        elif avg_funding > 0:
            bearish += score
            reasons.append("funding_positive")

    if int(types.get("perp_funding_divergence", 0)) > 0:
        if avg_funding < 0:
            bullish += 0.04
            reasons.append("funding_divergence")
        elif avg_funding > 0:
            bearish += 0.04
            reasons.append("funding_divergence")

    return {"name": "funding_baseline", "bullish": _scaled(bullish), "bearish": _scaled(bearish), "reasons": reasons}


def _strategy_oi_acceleration(rows: List[Dict[str, Any]], types: Counter) -> Dict[str, Any]:
    bullish = 0.0
    bearish = 0.0
    reasons: List[str] = []

    accel_rows = _rows_of_type(rows, "perp_open_interest_acceleration")
    if not accel_rows:
        return {"name": "oi_acceleration", "bullish": 0.0, "bearish": 0.0, "reasons": []}

    best_row = None
    best_score = 0.0

    for row in accel_rows:
        current_change_pct = _parse_summary_float(row.get("summary"), "current_change_pct", 0.0)
        acceleration_pct = _parse_summary_float(row.get("summary"), "acceleration_pct", 0.0)
        strength = abs(current_change_pct) + abs(acceleration_pct)

        if strength > best_score:
            best_score = strength
            best_row = row

    if not best_row:
        return {"name": "oi_acceleration", "bullish": 0.0, "bearish": 0.0, "reasons": []}

    current_change_pct = _parse_summary_float(best_row.get("summary"), "current_change_pct", 0.0)
    acceleration_pct = _parse_summary_float(best_row.get("summary"), "acceleration_pct", 0.0)

    if current_change_pct >= 0.75 and acceleration_pct >= 0.50:
        bullish += min(0.18, 0.08 + (abs(acceleration_pct) / 10.0))
        reasons.append("oi_accel_base")
    elif current_change_pct <= -0.75 and acceleration_pct <= -0.50:
        bearish += min(0.18, 0.08 + (abs(acceleration_pct) / 10.0))
        reasons.append("oi_unwind_base")
    elif current_change_pct > 0 and acceleration_pct <= -0.75:
        bearish += 0.08
        reasons.append("oi_build_fading")

    return {"name": "oi_acceleration", "bullish": _scaled(bullish), "bearish": _scaled(bearish), "reasons": reasons}


def _strategy_micro_trend(rows: List[Dict[str, Any]], types: Counter) -> Dict[str, Any]:
    bullish = 0.0
    bearish = 0.0
    reasons: List[str] = []

    oi_change_rows = _rows_of_type(rows, "perp_open_interest_change")
    if not oi_change_rows:
        return {"name": "micro_trend", "bullish": 0.0, "bearish": 0.0, "reasons": []}

    positive_moves = 0
    negative_moves = 0

    for row in oi_change_rows:
        oi_change_pct = _parse_summary_float(row.get("summary"), "oi_change_pct", 0.0)

        if oi_change_pct >= 0.75:
            positive_moves += 1
        elif oi_change_pct <= -0.75:
            negative_moves += 1

    if positive_moves > 0:
        bullish += min(0.14, 0.06 + (positive_moves * 0.02))
        reasons.append("oi_build_micro")

    if negative_moves > 0:
        bearish += min(0.14, 0.06 + (negative_moves * 0.02))
        reasons.append("oi_unwind_micro")

    return {"name": "micro_trend", "bullish": _scaled(bullish), "bearish": _scaled(bearish), "reasons": reasons}


def _strategy_breakout_continuation(rows: List[Dict[str, Any]], types: Counter) -> Dict[str, Any]:
    bullish = 0.0
    bearish = 0.0
    reasons: List[str] = []

    if int(types.get("perp_trend_bullish", 0)) > 0 and int(types.get("perp_open_interest_build_accelerating", 0)) > 0:
        bullish += 0.20
        reasons.append("breakout_bull")
