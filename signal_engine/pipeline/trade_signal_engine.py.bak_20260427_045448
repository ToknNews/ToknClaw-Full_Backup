            bullish += _scaled(0.03)
            reasons.append("high_oi")
        elif bearish > bullish:
            bearish += _scaled(0.03)
            reasons.append("high_oi")

    if has_oi_divergence:
        if bullish > bearish:
            bullish += _scaled(0.02)
            reasons.append("oi_divergence")
        elif bearish > bullish:
            bearish += _scaled(0.02)
            reasons.append("oi_divergence")

    return bullish, bearish, reasons

