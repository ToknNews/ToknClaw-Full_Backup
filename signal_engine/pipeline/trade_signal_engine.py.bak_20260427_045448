def _calculate_conflict_score(bullish: float, bearish: float) -> float:
    total = bullish + bearish
    if total <= 0:
        return 0.0

    weaker = min(bullish, bearish)
    return round(_clamp(weaker / total), 6)

def _apply_conflict_penalty(bullish: float, bearish: float) -> Tuple[float, float, float]:
    conflict_score = _calculate_conflict_score(bullish, bearish)

    heavy_threshold = _cfg_float("conflict_heavy_penalty", 0.60)
    light_threshold = _cfg_float("conflict_light_penalty", 0.40)
    heavy_multiplier = _cfg_float("conflict_heavy_multiplier", 0.78)
    light_multiplier = _cfg_float("conflict_light_multiplier", 0.90)

    if conflict_score >= heavy_threshold:
        bullish *= heavy_multiplier
        bearish *= heavy_multiplier
    elif conflict_score >= light_threshold:
        bullish *= light_multiplier
        bearish *= light_multiplier

    return round(bullish, 6), round(bearish, 6), conflict_score

def _resolve_direction(bullish: float, bearish: float, conflict_score: float) -> str:
    diff = bullish - bearish
    abs_diff = abs(diff)

    if max(bullish, bearish) < _cfg_float("min_actionable_score", 0.08):
        return "no_trade"

    if conflict_score >= _cfg_float("conflict_hard_no_trade", 0.60):
        return "no_trade"

    if abs_diff < _cfg_float("min_neutral_diff", 0.06):
        return "neutral"

    strong_score_threshold = _cfg_float("strong_score_threshold", 0.35)
    strong_diff_threshold = _cfg_float("strong_diff_threshold", 0.14)
    weak_direction_score_threshold = _cfg_float("weak_direction_score_threshold", 0.16)
    direction_dominance_ratio = _cfg_float("direction_dominance_ratio", 1.20)

    if diff > 0:
        if bullish >= strong_score_threshold and abs_diff >= strong_diff_threshold:
            return "strong_bullish"
        if bullish >= weak_direction_score_threshold and bullish > bearish * direction_dominance_ratio:
            return "bullish"

    if diff < 0:
        if bearish >= strong_score_threshold and abs_diff >= strong_diff_threshold:
            return "strong_bearish"
        if bearish >= weak_direction_score_threshold and bearish > bullish * direction_dominance_ratio:
            return "bearish"

    return "neutral"

def _confidence_from_scores(bullish: float, bearish: float, conflict_score: float) -> float:
    total = bullish + bearish
    if total <= 0:
        return 0.0

    dominance = abs(bullish - bearish) / total  # 0 → 1
    penalty = 1.0 - min(conflict_score, 0.50)

    confidence = dominance * penalty

    # soft cap (prevents saturation)
    return round(min(confidence, 0.85), 6)

def _priority_score(confidence: float, signal_count: int, direction: str) -> float:
    direction_multiplier = 1.0

    if direction in {"strong_bullish", "strong_bearish"}:
        direction_multiplier = _cfg_float("priority_strong_multiplier", 1.20)
    elif direction in {"bullish", "bearish"}:
        direction_multiplier = _cfg_float("priority_directional_multiplier", 1.05)
    elif direction == "no_trade":
        direction_multiplier = _cfg_float("priority_no_trade_multiplier", 0.40)
    elif direction == "neutral":
        direction_multiplier = _cfg_float("priority_neutral_multiplier", 0.70)

    score = confidence * (1.0 + min(signal_count, 20) / 12.0) * direction_multiplier
    return round(_clamp(score), 6)

def _dominant_setup_family(family_scores: Dict[str, Dict[str, float]]) -> str:
    best_name = "none"
    best_score = 0.0

    for name, payload in family_scores.items():
        value = max(_safe_float(payload.get("bullish"), 0.0), _safe_float(payload.get("bearish"), 0.0))
        if value > best_score:
            best_name = name
            best_score = value

    return best_name

def _entry_style_from_direction(direction: str, dominant_family: str) -> str:
    if direction == "no_trade":
        return "stand_aside"

    if dominant_family in {"crowding_fade"}:
        return "fade"

    if dominant_family in {"trend_continuation", "breakout_continuation"}:
        return "momentum"

    if dominant_family in {"micro_trend", "oi_acceleration"}:
        return "probe"

    return "balanced"

def _agent_notes(
    direction: str,
    dominant_family: str,
    conflict_score: float,
    priority_score: float,
) -> List[str]:
    notes: List[str] = []

    if direction == "no_trade":
        notes.append("Signal conflict or insufficient edge. Stand aside.")
    elif dominant_family == "crowding_fade":
        notes.append("Contrarian crowding setup. Watch reversal quality.")
    elif dominant_family == "trend_continuation":
        notes.append("Continuation setup. Favor follow-through confirmation.")
    elif dominant_family == "breakout_continuation":
        notes.append("Breakout-style setup. Monitor momentum persistence.")

    if conflict_score >= _cfg_float("conflict_light_penalty", 0.40):
        notes.append("Mixed evidence present. Use smaller sizing or wait for confirmation.")

    if priority_score >= 0.70:
        notes.append("High-priority candidate for ranking / rotation.")

    return notes[:3]

# ---------------------------------------------------
# CORE ENGINE
# ---------------------------------------------------

def build_trade_signals(snapshot: Dict[str, Any]) -> Dict[str, Any]:
    if not isinstance(snapshot, dict):
        snapshot = {}

    # ---------------------------------------------------
    # TREND INJECTION (CRITICAL)
    # ---------------------------------------------------

    snapshot = _inject_trend_signals(snapshot)

    signals_map = _signals_by_entity(snapshot)
    rows: List[Dict[str, Any]] = []
    weights = load_config(WEIGHTS_FILE)
    if not isinstance(weights, dict):
        weights = {}

    for _, data in signals_map.items():
        entity = data["entity"]
        types = data["types"]
        signal_rows = data["rows"]

        bullish = 0.0
        bearish = 0.0
        reasons: List[str] = []
        family_scores: Dict[str, Dict[str, float]] = {}

        # ---------------------------------------------------
        # 1. DISCRETE SIGNAL LAYER
        # ---------------------------------------------------

        d_bullish, d_bearish, d_reasons = _apply_discrete_rules(types)
        bullish += d_bullish
        bearish += d_bearish
        reasons.extend(d_reasons)

        family_scores["discrete_rules"] = {
            "bullish": round(d_bullish, 6),
            "bearish": round(d_bearish, 6),
        }

        # ---------------------------------------------------
        # 2. STRATEGY FAMILIES
        # ---------------------------------------------------

        families = [
            _strategy_crowding_fade(signal_rows, types),
            _strategy_trend_continuation(signal_rows, types),
            _strategy_funding_baseline(signal_rows, types),
            _strategy_oi_acceleration(signal_rows, types),
            _strategy_micro_trend(signal_rows, types),
            _strategy_breakout_continuation(signal_rows, types),
        ]

        for family in families:
            family_name = _safe_str(family.get("name")) or "unknown"
            family_bullish = _safe_float(family.get("bullish"), 0.0)
            family_bearish = _safe_float(family.get("bearish"), 0.0)
            family_reasons = _safe_list(family.get("reasons"))

            weight = _safe_float(weights.get(family_name, 1.0), 1.0)

            weighted_bullish = family_bullish * weight
            weighted_bearish = family_bearish * weight

            bullish += weighted_bullish
            bearish += weighted_bearish

            reasons.extend([_safe_str(x) for x in family_reasons])

            family_scores[family_name] = {
                "bullish": round(weighted_bullish, 6),
                "bearish": round(weighted_bearish, 6),
            }

        # ---------------------------------------------------
        # 3. CONVICTION MODIFIERS
        # ---------------------------------------------------

        bullish, bearish, reasons = _apply_conviction_modifiers(
            rows=signal_rows,
            types=types,
            bullish=bullish,
            bearish=bearish,
            reasons=reasons,
        )

        # ---------------------------------------------------
        # 4. FALLBACK SIGNAL (CONFIG-DRIVEN)
        # ---------------------------------------------------

        if bullish == 0.0 and bearish == 0.0:
            fallback_bias = _cfg_float("fallback_bias", 0.05)
            if fallback_bias > 0:
                bearish += fallback_bias
                reasons.append("fallback_bias")

        # ---------------------------------------------------
        # 5. CONFLICT HANDLING
        # ---------------------------------------------------

        bullish, bearish, conflict_score = _apply_conflict_penalty(bullish, bearish)

        # ---------------------------------------------------
        # 6. DECISION LAYER
        # ---------------------------------------------------

        direction = _resolve_direction(bullish, bearish, conflict_score)
        confidence = _confidence_from_scores(bullish, bearish, conflict_score)
        dominant_family = _dominant_setup_family(family_scores)
        entry_style = _entry_style_from_direction(direction, dominant_family)
        signal_count = sum(types.values())
        priority_score = _priority_score(confidence, signal_count, direction)

        # ---------------------------------------------------
        # 7. EXPLAINABILITY / OPENCLAW
        # ---------------------------------------------------

        perp_setups = [
            _safe_str(r.get("summary"))
            for r in signal_rows
            if _safe_str(r.get("signal_type")) == "perp_broadcast_setup"
        ][:3]

        rows.append({
            "entity": entity,
            "direction": direction,
            "confidence": round(confidence, 6),
            "priority_score": priority_score,
            "entry_style": entry_style,
            "setup_family": dominant_family,
            "conflict_score": round(conflict_score, 6),
            "no_trade": direction == "no_trade",
            "reasons": _unique_reasons(reasons, limit=_cfg_int("max_reasons", 10)),
            "perp_setups": perp_setups,
            "signal_count": signal_count,
            "score_breakdown": {
                "bullish": round(bullish, 6),
                "bearish": round(bearish, 6),
                "net": round(bullish - bearish, 6),
            },
            "family_breakdown": family_scores,
            "strategy_modules": [
                "discrete_rules",
                "crowding_fade",
                "trend_continuation",
                "funding_baseline",
                "oi_acceleration",
                "micro_trend",
                "breakout_continuation",
                "conviction_modifiers",
                "conflict_penalty",
            ],
            "agent_notes": _agent_notes(
                direction=direction,
                dominant_family=dominant_family,
                conflict_score=conflict_score,
                priority_score=priority_score,
            ),
            "generated_at": _now().isoformat(),
        })

    rows.sort(
        key=lambda x: (
            _safe_float(x.get("priority_score"), 0.0),
            _safe_float(x.get("confidence"), 0.0),
            _safe_int_like(x.get("signal_count"), 0),
            _safe_str(x.get("entity")),
        ),
        reverse=True,
    )

    summary = {
        "entity_count": len(rows),
        "strong_bullish_count": sum(1 for r in rows if r["direction"] == "strong_bullish"),
        "bullish_count": sum(1 for r in rows if r["direction"] == "bullish"),
        "neutral_count": sum(1 for r in rows if r["direction"] == "neutral"),
        "no_trade_count": sum(1 for r in rows if r["direction"] == "no_trade"),
        "bearish_count": sum(1 for r in rows if r["direction"] == "bearish"),
        "strong_bearish_count": sum(1 for r in rows if r["direction"] == "strong_bearish"),
        "top_setup_families": Counter([_safe_str(r.get("setup_family")) for r in rows]).most_common(5),
    }

    return {
        "rows": rows[:_cfg_int("max_output_rows", 50)],
        "summary": summary,
    }

