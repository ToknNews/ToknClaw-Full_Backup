def _apply_discrete_rules(types: Counter) -> Tuple[float, float, List[str]]:
    bullish = 0.0
    bearish = 0.0
    reasons: List[str] = []

    for signal_type, rule in DISCRETE_SIGNAL_RULES.items():
        count = int(types.get(signal_type, 0))
        if count <= 0:
            continue

        score = _safe_float(rule.get("score"), 0.0) * count
        bias = _safe_str(rule.get("bias"))
        reason = _safe_str(rule.get("reason"))

        if bias == "bullish":
            bullish += score
        elif bias == "bearish":
            bearish += score

        if reason:
            reasons.append(reason)

    return _scaled(bullish), _scaled(bearish), reasons

