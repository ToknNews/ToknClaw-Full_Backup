def _safe_list(x: Any) -> List[Any]:
    return x if isinstance(x, list) else []

def _safe_dict(x: Any) -> Dict[str, Any]:
    return x if isinstance(x, dict) else {}

def _safe_str(x: Any) -> str:
    return str(x or "").strip()

def _safe_float(x: Any, d: float = 0.0) -> float:
    try:
        return float(x)
    except Exception:
        return d

def _safe_int_like(x: Any, default: int = 0) -> int:
    try:
        return int(x)
    except Exception:
        return default

def _safe_bool(x: Any, default: bool = False) -> bool:
    if isinstance(x, bool):
        return x
    if isinstance(x, str):
        return x.strip().lower() in {"1", "true", "yes", "on"}
    if isinstance(x, (int, float)):
        return bool(x)
    return default

def _now() -> datetime:
    return datetime.now(UTC)

def _clamp(x: float, low: float = 0.0, high: float = 1.0) -> float:
    return max(low, min(high, x))

def _cfg_float(key: str, default: float) -> float:
    return _safe_float(ENGINE_CONFIG.get(key), default)

def _cfg_int(key: str, default: int) -> int:
    return _safe_int_like(ENGINE_CONFIG.get(key), default)

def _cfg_bool(key: str, default: bool) -> bool:
    return _safe_bool(ENGINE_CONFIG.get(key), default)

def _scaled(score: float) -> float:
    amplifier = _cfg_float("signal_amplifier", 5.0)
    return round(score * amplifier, 6)

def _parse_summary_float(summary: Any, key: str, default: float = 0.0) -> float:
    text = _safe_str(summary)
    if not text:
        return default

    pattern = rf"{re.escape(key)}=([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)"
    match = re.search(pattern, text)

    if not match:
        return default

    return _safe_float(match.group(1), default)

def _rows_of_type(rows: List[Dict[str, Any]], signal_type: str) -> List[Dict[str, Any]]:
    return [r for r in rows if _safe_str(r.get("signal_type")) == signal_type]

def _unique_reasons(reasons: List[str], limit: int = 10) -> List[str]:
    seen = set()
    out: List[str] = []

    for reason in reasons:
        text = _safe_str(reason)
        if not text or text in seen:
            continue
        seen.add(text)
        out.append(text)
        if len(out) >= limit:
            break

    return out

def _inject_trend_signals(snapshot: Dict[str, Any]) -> Dict[str, Any]:
    if not _cfg_bool("inject_trend_signals", True):
        return snapshot

    signals = snapshot.get("signals")
    if not isinstance(signals, list):
        snapshot["signals"] = []
        signals = snapshot["signals"]

    trend_signals = build_price_oi_trend(snapshot)
    if not isinstance(trend_signals, list) or not trend_signals:
        return snapshot

    if not _cfg_bool("trend_signal_dedup", True):
        signals.extend(trend_signals)
        return snapshot

    existing_keys = set()
    for row in signals:
        row = _safe_dict(row)
        existing_keys.add((
            _safe_str(row.get("signal_type")),
            _safe_str(row.get("entity")).upper(),
        ))

    for row in trend_signals:
        row = _safe_dict(row)
        key = (
            _safe_str(row.get("signal_type")),
            _safe_str(row.get("entity")).upper(),
        )

        if key in existing_keys and not _cfg_bool("trend_signal_allow_replace", False):
            continue

        signals.append(row)
        existing_keys.add(key)

    return snapshot

