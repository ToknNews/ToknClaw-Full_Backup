def _signals_by_entity(snapshot: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
    out: Dict[str, Dict[str, Any]] = {}

    for s in _safe_list(snapshot.get("signals")):
        s = _safe_dict(s)

        raw_entity = _safe_str(s.get("entity"))
        entity = raw_entity.upper()

        if not entity:
            continue

        bucket = out.setdefault(entity, {
            "entity": raw_entity or entity,
            "rows": [],
            "types": Counter(),
        })

        signal_type = _safe_str(s.get("signal_type"))
        if signal_type:
            bucket["types"][signal_type] += 1

        bucket["rows"].append(s)

    return out

