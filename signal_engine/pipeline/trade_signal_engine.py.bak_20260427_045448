        return bullish, bearish, reasons

    has_high_oi = len(_rows_of_type(rows, "perp_open_interest_high")) > 0
    has_oi_divergence = len(_rows_of_type(rows, "perp_open_interest_divergence")) > 0

    if has_high_oi:
