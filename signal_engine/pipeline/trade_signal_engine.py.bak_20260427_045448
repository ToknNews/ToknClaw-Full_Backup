    if negative_moves > 0:
        bearish += min(0.14, 0.06 + (negative_moves * 0.02))
        reasons.append("oi_unwind_micro")

    return {
        "name": "micro_trend",
        "bullish": _scaled(bullish),
        "bearish": _scaled(bearish),
        "reasons": reasons,
    }

