OI_HISTORY_PATH = Path("/opt/toknclaw/data/flow/open_interest_history.json")
OI_HISTORY_TMP_PATH = Path("/opt/toknclaw/data/flow/open_interest_history.tmp")

DEFAULT_CONFIG: Dict[str, Any] = {
