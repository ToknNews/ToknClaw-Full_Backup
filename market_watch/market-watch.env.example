# No secrets are required for public market data or offline tests.
# Load through systemd EnvironmentFile. Do not commit a completed copy.
MARKET_WATCH_DATABASE=/var/lib/tokn-market-watch/state.sqlite3

# Collection-only defaults. Both switches are required to enable publishing.
MARKET_WATCH_ENABLE_DELIVERY=0
MARKET_WATCH_DELIVERY_ARGS=

# Discord first: distinct private paid channel and optional public sample channel.
MARKET_WATCH_DISCORD_PAID_WEBHOOK=
MARKET_WATCH_DISCORD_FREE_WEBHOOK=

# Optional Telegram notification adapter; no payments are implemented in the bot.
MARKET_WATCH_TELEGRAM_BOT_TOKEN=
MARKET_WATCH_TELEGRAM_PAID_CHAT_ID=
MARKET_WATCH_TELEGRAM_FREE_CHAT_ID=
